{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jianghu Random Event Library",
  "type": "object",
  "required": [
    "library_id",
    "version",
    "language",
    "event_count",
    "events"
  ],
  "properties": {
    "library_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "event_count": {
      "type": "integer",
      "const": 100
    },
    "events": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "weight",
          "description",
          "conditions",
          "choices"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^event_[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "description": {
            "type": "string"
          },
          "conditions": {
            "type": "object"
          },
          "choices": {
            "type": "array",
            "minItems": 3
          }
        }
      }
    }
  }
}