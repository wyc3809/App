{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "title", "category", "choices"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "category": {"type": "string"},
    "location_id": {"type": "string"},
    "choices": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "text", "feedback"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "feedback": {"type": "string"},
          "outcomes": {"type": "object"}
        }
      }
    }
  }
}
